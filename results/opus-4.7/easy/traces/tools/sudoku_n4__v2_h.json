      "args": {
        "code": "\nfrom pysat.solvers import Glucose3\nfrom pysat.card import CardEnc, EncType\nfrom pysat.formula import IDPool\n\nN = 16\nB = 4\nvpool = IDPool()\ndef v(r,c,d): return vpool.id((r,c,d))\n\nclauses = []\n\n# each cell has exactly one value\nfor r in range(N):\n    for c in range(N):\n        lits = [v(r,c,d) for d in range(1,N+1)]\n        clauses.append(lits)\n        for i in range(len(lits)):\n            for j in range(i+1,len(lits)):\n                clauses.append([-lits[i],-lits[j]])\n\n# rows\nfor r in range(N):\n    for d in range(1,N+1):\n        lits = [v(r,c,d) for c in range(N)]\n        clauses.append(lits)\n        for i in range(len(lits)):\n            for j in range(i+1,len(lits)):\n                clauses.append([-lits[i],-lits[j]])\n\n# cols\nfor c in range(N):\n    for d in range(1,N+1):\n        lits = [v(r,c,d) for r in range(N)]\n        clauses.append(lits)\n        for i in range(len(lits)):\n            for j in range(i+1,len(lits)):\n                clauses.append([-lits[i],-lits[j]])\n\n# blocks\nfor br in range(B):\n    for bc in range(B):\n        for d in range(1,N+1):\n            lits = [v(br*B+i, bc*B+j, d) for i in range(B) for j in range(B)]\n            clauses.append(lits)\n            for i in range(len(lits)):\n                for j in range(i+1,len(lits)):\n                    clauses.append([-lits[i],-lits[j]])\n\nfixed = {5:6, 13:14, 14:15, 18:7, 22:3, 26:15, 27:16, 33:10, 34:11, 42:3, 53:10, 54:11, 57:6, 58:7, 69:5, 71:7, 80:6, 81:5, 83:7, 84:2, 85:1, 94:12, 103:15, 106:4, 107:3, 109:5, 112:14, 115:15, 120:6, 135:6, 136:11, 140:15, 141:16, 148:3, 150:1, 170:1, 175:6, 185:8, 188:3, 190:1, 196:8, 199:5, 201:11, 203:9, 208:8, 218:14, 240:16, 241:15, 243:13, 244:12, 253:3}\n\nfor idx, val in fixed.items():\n    r, c = idx//16, idx%16\n    clauses.append([v(r,c,val)])\n\ns = Glucose3()\nfor cl in clauses:\n    s.add_clause(cl)\n\nprint(s.solve())\nmodel = set(s.get_model())\ngrid = [0]*256\nfor r in range(N):\n    for c in range(N):\n        for d in range(1,N+1):\n            if v(r,c,d) in model:\n                grid[r*16+c] = d\n                break\nprint(grid)\n"
