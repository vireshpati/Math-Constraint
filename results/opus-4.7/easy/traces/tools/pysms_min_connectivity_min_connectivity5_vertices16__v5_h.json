        "code": "\nrequired = [(1,10), (4,10), (7,10), (1,6), (5,13), (3,6), (0,6), (0,15), (9,13), (3,12), (2,7), (4,14), (1,12), (8,13), (11,14), (5,12), (4,12), (5,14), (0,4), (6,7), (8,9), (9,12), (2,8), (10,14)]\n\nn = 16\nedges = set()\nfor u,v in required:\n    edges.add((min(u,v), max(u,v)))\n\n# Add circulant C_16(1,2,3,4,5)\nfor i in range(n):\n    for d in range(1,6):\n        j = (i+d) % n\n        u,v = min(i,j), max(i,j)\n        edges.add((u,v))\n\nedges = sorted(edges)\nprint(len(edges))\n\n# Check vertex connectivity using networkx\nimport networkx as nx\nG = nx.Graph()\nG.add_nodes_from(range(n))\nG.add_edges_from(edges)\nprint(\"connectivity:\", nx.node_connectivity(G))\nprint(\"min degree:\", min(dict(G.degree()).values()))\nfor u,v in required:\n    assert G.has_edge(u,v)\nprint(edges)\n"
