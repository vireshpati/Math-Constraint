        "code": "\nimport networkx as nx\n\nfixed = [(2,9), (0,10), (15,17), (12,15), (2,6), (3,17), (0,14), (11,13), (9,14), (6,12), (10,13), (1,10), (11,17), (10,16), (1,5), (6,14), (5,10), (1,9), (4,14), (15,16), (3,12), (13,16), (2,3), (10,15), (7,13), (6,16), (2,8), (3,10), (0,15), (2,16)]\n\nn = 18\nedges = set()\nfor u,v in fixed:\n    edges.add((min(u,v), max(u,v)))\n\n# Add circulant C(18; 1,2,3,4)\nfor i in range(n):\n    for d in [1,2,3,4]:\n        u, v = i, (i+d)%n\n        edges.add((min(u,v), max(u,v)))\n\nG = nx.Graph()\nG.add_nodes_from(range(n))\nG.add_edges_from(edges)\n\nprint(\"connectivity:\", nx.node_connectivity(G))\nprint(\"num edges:\", len(edges))\n# Verify all fixed edges present\nfor e in fixed:\n    assert tuple(sorted(e)) in edges\nprint(\"ok\")\nprint(sorted(edges))\n"
