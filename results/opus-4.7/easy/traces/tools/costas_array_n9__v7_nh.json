        "code": "\nfrom itertools import permutations\n\ndef is_costas(p):\n    n = len(p)\n    seen = set()\n    for d in range(1, n):\n        for c in range(n-d):\n            v = (p[c+d]-p[c], d)\n            if v in seen: return False\n            seen.add(v)\n    return True\n\nfor p in permutations(range(9)):\n    if is_costas(p):\n        print(list(p))\n        break\n"
