        "code": "\nedges = [(u, v) for u in range(7) for v in range(7, 14)]\n# Verify triangle-free\nfrom itertools import combinations\nadj = {i: set() for i in range(14)}\nfor u,v in edges:\n    adj[u].add(v); adj[v].add(u)\n# check no triangle\nfor a,b,c in combinations(range(14),3):\n    if b in adj[a] and c in adj[a] and c in adj[b]:\n        print(\"triangle!\", a,b,c); break\nelse:\n    print(\"no triangles\")\n# check maximal\nfor a,b in combinations(range(14),2):\n    if b not in adj[a]:\n        # adding (a,b) should create triangle => a,b share neighbor\n        if not (adj[a] & adj[b]):\n            print(\"not maximal\", a,b); break\nelse:\n    print(\"maximal\")\nprint(len(edges))\n"
