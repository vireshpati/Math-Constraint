        "code": "\ndef solve(n=7):\n    seq=[0]*(2*n)\n    def bt(v):\n        if v==0:\n            return seq[:]\n        for i in range(2*n-v-1):\n            if seq[i]==0 and seq[i+v+1]==0:\n                seq[i]=v;seq[i+v+1]=v\n                r=bt(v-1)\n                if r: return r\n                seq[i]=0;seq[i+v+1]=0\n        return None\n    return bt(n)\nprint(solve(7))\n"
