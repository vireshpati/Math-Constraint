{"name": "execute_python", "args": {"code": "\n# Use Bron-Kerbosch with pivoting to find maximum clique\ndef bron_kerbosch(R, P, X, adj, best):\n    if not P and not X:\n        if len(R) > len(best[0]):\n            best[0] = R.copy()\n        return\n    \n    if len(R) + len(P) <= len(best[0]):\n        return  # pruning\n    \n    # Choose pivot with max connections to P\n    pivot = max(P | X, key=lambda v: sum(1 for u in P if adj[v][u]))\n    \n    for v in list(P - set(neighbors(pivot, adj, P))):\n        neighbors_v = set(u for u in range(44) if adj[v][u])\n        bron_kerbosch(R | {v}, P & neighbors_v, X & neighbors_v, adj, best)\n        P.remove(v)\n        X.add(v)\n\ndef neighbors(v, adj, candidates=None):\n    if candidates is None:\n        return [u for u in range(44) if adj[v][u]]\n    return [u for u in candidates if adj[v][u]]\n\nbest = [[]]\nbron_kerbosch(set(), set(range(44)), set(), adj, best)\nprint(\"Maximum clique size:\", len(best[0]))\nprint(\"Maximum clique:\", sorted(best[0]))\n"}, "ok": false, "latency_ms": 32.01}, {"name": "execute_python", "args": {"code": "\nimport sys\nsys.setrecursionlimit(100000)\n\nedges = [(0,3), (0,4), (0,5), (0,6), (0,8), (0,9), (0,10), (0,12), (0,13), (0,17), (0,18), (0,20), (0,22), (0,24), (0,26), (0,27), (0,28), (0,30), (0,32), (0,34), (0,36), (0,38), (0,40), (0,42), (1,2), (1,3), (1,4), (1,5), (1,6), (1,8), (1,9), (1,11), (1,12), (1,13), (1,15), (1,17), (1,18), (1,19), (1,21), (1,23), (1,24), (1,26), (1,27), (1,28), (1,29), (1,31), (1,32), (1,36), (1,37), (1,39), (1,42), (1,43), (2,4), (2,5), (2,7), (2,8), (2,9), (2,10), (2,11), (2,13), (2,14), (2,17), (2,21), (2,22), (2,27), (2,29), (2,31), (2,33), (2,34), (2,37), (2,39), (2,40), (3,4), (3,5), (3,6), (3,7), (3,12), (3,13), (3,14), (3,17), (3,23), (3,24), (3,25), (3,26), (3,28), (3,29), (3,30), (3,32), (3,34), (3,35), (3,37), (3,38), (3,40), (3,42), (4,5), (4,6), (4,7), (4,13), (4,15), (4,16), (4,18), (4,20), (4,21), (4,23), (4,24), (4,26), (4,27), (4,29)