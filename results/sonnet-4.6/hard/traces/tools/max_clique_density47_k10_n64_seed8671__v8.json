 -x[1])[:20])\n"}, "ok": true, "latency_ms": 625.6}, {"name": "execute_python", "args": {"code": "\n# Use a greedy + backtracking approach to find large cliques\n# Start with Bron-Kerbosch with pruning\n\ndef bron_kerbosch_max(adj_set, n):\n    best = []\n    \n    def bronk(R, P, X):\n        nonlocal best\n        if not P and not X:\n            if len(R) > len(best):\n                best = R[:]\n            return\n        if len(R) + len(P) <= len(best):\n            return  # pruning\n        \n        # Choose pivot to maximize |P \u2229 N(u)|\n        pivot = max(P | X, key=lambda u: len(adj_set[u] & P))\n        \n        for v in list(P - adj_set[pivot]):\n            bronk(R + [v], P & adj_set[v], X & adj_set[v])\n            P.remove(v)\n            X.add(v)\n    \n    # Order vertices by degree for better pruning\n    order = sorted(range(n), key=lambda x: degrees[x], reverse=True)\n    \n    P = set(range(n))\n    X = set()\n    bronk([], P, X)\n    return best\n\nimport sys\nsys.setrecursionlimit(100000)\n\nresult = bron_kerbosch_max(adj_set, n)\nprint(f\"Largest clique found: {len(result)}\")\nprint(f\"Vertices: {sorted(result)}\")\n", "timeout_seconds": 60}, "ok": false, "latency_ms": 697.2}, {"name": "execute_python", "args": {"code": "\nimport sys\nsys.setrecursionlimit(100000)\n\nedges = [(0,2), (0,3), (0,7), (0,10), (0,11), (0,15), (0,17), (0,18), (0,19), (0,22), (0,23), (0,24), (0,25), (0,29), (0,30), (0,31), (0,33), (0,34), (0,38), (0,44), (0,46), (0,48), (0,49), (0,51), (0,52), (0,53), (0,54), (0,57), (0,61), (0,62), (1,3), (1,4), (1,5), (1,6), (1,7), (1,8), (1,9), (1,10), (1,13), (1,16), (1,17), (1,18), (1,19), (1,21), (1,23), (1,25), (1,26), (1,27), (1,32), (1,37), (1,38), (1,40), (1,44), (1,46), (1,47), (1,48), (1,53), (1,57), (1,60), (1,62), (2,4), (2,11), (2,13), (2,18), (2,19), (2,20), (2,23), (2,25), (2,26), (2,29), (2,37), (2,41), (2,43), (2,49), (2,50), (2,51), (2,52), (2,58), (2,63), (3,4), (3,7), (3,10), (3,11), (3,12), (3,14), (3