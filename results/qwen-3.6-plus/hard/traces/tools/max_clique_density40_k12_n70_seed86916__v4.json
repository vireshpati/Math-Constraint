 P & adj[v]\n                    expand(R + [v], new_P)\n                    P.discard(v)\n    \n    expand([], set(vertices))\n    return best\n\n# Run the algorithm\nresult = max_clique_tomita(list(range(n)))\nprint(f\"Maximum clique size (Tomita): {len(result)}\")\nprint(f\"Maximum clique: {sorted(result)}\")\n\n# Verify\nfor i in range(len(result)):\n    for j in range(i+1, len(result)):\n        assert result[j] in adj[result[i]], f\"Missing edge between {result[i]} and {result[j]}\"\nprint(\"Verification passed!\")\n",
