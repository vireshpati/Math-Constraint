e color\n    solver.add_clause([var(v, c) for c in range(4)])\n    # At most one color (pairwise)\n    for c1 in range(4):\n        for c2 in range(c1+1, 4):\n            solver.add_clause([-var(v, c1), -var(v, c2)])\n\n# For each edge, adjacent vertices can't have same color\nfor u, v in edges:\n    for c in range(4):\n        solver.add_clause([-var(u, c), -var(v, c)])\n\n# Solve\nif solver.solve():\n    model = solver.get_model()\n    coloring = [0] * 45\n    for v in range(45):\n        for c in range(4):\n            if model[var(v, c) - 1] > 0:\n                coloring[v] = c\n                break\n    print(\"SATISFIABLE\")\n    print(\"Coloring:\", coloring)\n    \n    # Verify\n    valid = True\n    for u, v in edges:\n        if coloring[u] == coloring[v]:\n            print(f\"ERROR: Edge ({u},{v}) has same color {coloring[u]}\")\n            valid = False\n    if valid:\n        print(\"Verification: VALID\")\nelse:\n    print(\"UNSATISFIABLE\")\n\nsolver.delete()\n",
