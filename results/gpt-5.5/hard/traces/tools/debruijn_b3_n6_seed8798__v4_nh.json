        "code": "def de_bruijn(k, n):\n    \"\"\"de Bruijn sequence for alphabet k and subsequences of length n.\"\"\"\n    a = [0] * (k * n)\n    sequence = []\n    def db(t, p):\n        if t > n:\n            if n % p == 0:\n                sequence.extend(a[1:p+1])\n        else:\n            a[t] = a[t-p]\n            db(t+1, p)\n            for j in range(a[t-p]+1, k):\n                a[t] = j\n                db(t+1, t)\n    db(1, 1)\n    return sequence\nseq=de_bruijn(3,6)\nprint(len(seq))\nprint(seq[:100])\n# verify length and substrings cyclic\nsubs=set()\nfor i in range(len(seq)):\n    tup=tuple(seq[(i+j)%len(seq)] for j in range(6))\n    subs.add(tup)\nprint(len(subs), len(subs)==3**6)\nprint(all(x in (0,1,2) for x in seq))\n# print full as repr maybe\nprint(seq)\n",
