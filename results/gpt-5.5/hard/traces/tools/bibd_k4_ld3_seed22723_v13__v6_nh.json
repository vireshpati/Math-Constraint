        "code": "v=13\nD=[0,1,3,9]\n# columns: for t=0..12, repeat line t 3 times\nM=[]\nfor i in range(v):\n    row=[]\n    for t in range(v):\n        inc = 1 if i in [(d+t)%v for d in D] else 0\n        row.extend([inc]*3)\n    M.append(row)\n# verify\nprint(len(M), len(M[0]))\nprint([sum(r) for r in M])\nprint([sum(M[i][j] for i in range(v)) for j in range(39)])\nprint(sorted(set(sum(M[i][j]*M[k][j] for j in range(39)) for i in range(v) for k in range(i))))\nflat=[x for row in M for x in row]\nprint(len(flat), sum(flat))\nprint(flat)\n# print matrix rows\nfor r in M:\n    print(r)\n",
