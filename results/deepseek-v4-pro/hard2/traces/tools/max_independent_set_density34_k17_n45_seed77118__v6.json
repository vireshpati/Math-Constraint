 graph\n\nbest_iset = []\n\ndef bb_search(R, P, X):\n    # R: current independent set (list)\n    # P: candidates (set)\n    # X: excluded (set) - already processed\n    global best_iset\n    \n    if len(P) == 0 and len(X) == 0:\n        if len(R) > len(best_iset):\n            best_iset = R[:]\n            print(f\"Found IS of size {len(best_iset)}: {best_iset}\")\n        return\n    \n    # If we can't beat the best, prune\n    if len(R) + len(P) <= len(best_iset):\n        return\n    \n    # Choose pivot (from P union X) to minimize branching\n    # Bron-Kerbosch with pivot\n    pivot = max(P | X, key=lambda v: len(adj[v] & P)) if (P | X) else None\n    \n    # Candidates to branch on: P \\ N(pivot)\n    if pivot is not None:\n        candidates = P - adj[pivot]\n    else:\n        candidates = P\n        \n    for v in sorted(candidates, key=lambda x: len(adj[x] & P)):  # smallest degree first\n        # R + {v}\n        bb_search(R + [v], P & comp_adj[v], X & comp_adj[v])\n        P.remove(v)\n        X.add(v)\n\n# This is Bron-Kerbosch for maximal cliques in complement, which is same as max independent set\n# But let's just do a simpler branch and bound\n\n# Let's try a different approach: use integer linear programming via brute force with heuristics\n# Actually, let's try to find a large independent set using a local search\n\nimport random\n\ndef local_search(iterations=100000):\n    # Start with empty set, greedily add vertices\n    adj_list = {i: list(adj[i]) for i in range(45)}\n    \n    best_sol = None\n    best_size = 0\n    \n    for _ in range(iterations):\n        # Random greedy\n        remaining = set(range(45))\n        iset = []\n        order = list(range(45))\n        random.shuffle(order)\n        for v in order:\n            if v in remaining:\n                iset.append(v)\n                remaining -= {v} | adj[v]\n        \n        if len(iset) > best_size:\n            best_size = len(iset)\n            best_sol = iset\n           