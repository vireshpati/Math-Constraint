        "code": "\n# Generate STS(13) blocks\nv = 13\nbase_blocks = [(0,1,4), (0,2,7)]\n\nblocks_sts = []\nfor b in base_blocks:\n    for i in range(v):\n        block = tuple(sorted((x + i) % v for x in b))\n        blocks_sts.append(block)\n\n# Remove duplicates if any\nblocks_sts = sorted(set(blocks_sts))\nprint(f\"Number of STS(13) blocks: {len(blocks_sts)}\")\n\n# Now create 4 copies\nblocks = []\nfor _ in range(4):\n    blocks.extend(blocks_sts)\n\nprint(f\"Total blocks: {len(blocks)}\")\n\n# Build 13x104 incidence matrix\nmatrix_flat = []\nfor i in range(v):\n    for b_idx in range(len(blocks)):\n        if i in blocks[b_idx]:\n            matrix_flat.append(1)\n        else:\n            matrix_flat.append(0)\n\nprint(f\"Length: {len(matrix_flat)}\")\n\n# Verify row sums\nfor i in range(v):\n    row_sum = sum(matrix_flat[i*104:(i+1)*104])\n    print(f\"Row {i} sum: {row_sum}\")\n\n# Verify column sums\nfor j in range(104):\n    col_sum = sum(matrix_flat[i*104 + j] for i in range(v))\n    if col_sum != 3:\n        print(f\"Column {j} sum: {col_sum}\")\n\n# Verify pair inner products\nfor i1 in range(v):\n    for i2 in range(i1+1, v):\n        ip = sum(matrix_flat[i1*104 + j] * matrix_flat[i2*104 + j] for j in range(104))\n        if ip != 4:\n            print(f\"Pair ({i1},{i2}) inner product: {ip}\")\n\nprint(\"Verification complete\")\n"
