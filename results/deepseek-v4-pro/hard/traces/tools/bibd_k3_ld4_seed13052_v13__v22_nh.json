        "code": "\n# Construct STS(13) and verify\nv = 13\n# Base blocks for cyclic STS(13)\nbase_blocks = [(0,1,4), (0,2,7)]\n\nblocks = set()\nfor b in base_blocks:\n    for i in range(v):\n        block = tuple(sorted((x + i) % v for x in b))\n        blocks.add(block)\n\nprint(f\"Number of blocks: {len(blocks)}\")\n# Expected: 2 * 13 = 26, but some might be duplicates\nprint(f\"Blocks: {sorted(blocks)}\")\n\n# Verify properties\n# Each point appears in r blocks\ncounts = [0]*v\npair_counts = {}\nfor blk in blocks:\n    for p in blk:\n        counts[p] += 1\n    for i in range(3):\n        for j in range(i+1, 3):\n            pair = tuple(sorted((blk[i], blk[j])))\n            pair_counts[pair] = pair_counts.get(pair, 0) + 1\n\nprint(f\"Point counts: {counts}, all should be 6\")\nprint(f\"Pair count values: {set(pair_counts.values())}\")\nprint(f\"Number of pairs: {len(pair_counts)}\")\n"
