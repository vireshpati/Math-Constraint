      "args": {
        "code": "import itertools\n\ndef is_triangle_free(n, edges):\n    adj = [set() for _ in range(n)]\n    for u, v in edges:\n        adj[u].add(v)\n        adj[v].add(u)\n    \n    for i in range(n):\n        for j in adj[i]:\n            for k in adj[j]:\n                if k in adj[i]:\n                    return False\n    return True\n\ndef is_maximal(n, edges):\n    # A triangle-free graph is maximal if adding any edge creates a triangle.\n    # This is equivalent to saying that for every pair of non-adjacent vertices (u, v),\n    # there exists a vertex w such that (u, w) and (v, w) are edges.\n    adj = [set() for _ in range(n)]\n    for u, v in edges:\n        adj[u].add(v)\n        adj[v].add(u)\n        \n    for i in range(n):\n        for j in range(i + 1, n):\n            if j not in adj[i]:\n                # Check if there is a common neighbor\n                common_neighbor = False\n                for neighbor in adj[i]:\n                    if neighbor in adj[j]:\n                        common_neighbor = True\n                        break\n                if not common_neighbor:\n                    return False\n    return True\n\n# The complete bipartite graph K_{8,8} is triangle-free and maximal.\n# Let's verify this.\nn = 16\nedges = []\nfor u in range(8):\n    for v in range(8, 16):\n        edges.append((u, v))\n\nprint(f\"Is triangle-free: {is_triangle_free(n, edges)}\")\nprint(f\"Is maximal: {is_maximal(n, edges)}\")\n"
