        "code": "edges = []\nfor i in range(7):\n    for j in range(7, 14):\n        edges.append((i, j))\nprint(f\"Number of edges: {len(edges)}\")\nprint(\"Edges:\", edges[:10], \"...\")\n\n# Verify triangle-free\ntriangle_free = True\nfor u in range(14):\n    for v in range(u+1, 14):\n        for w in range(v+1, 14):\n            if ((u,v) in edges or (v,u) in edges) and \\\n               ((v,w) in edges or (w,v) in edges) and \\\n               ((u,w) in edges or (w,u) in edges):\n                triangle_free = False\n                print(f\"Triangle: {u},{v},{w}\")\n                break\n        if not triangle_free:\n            break\n    if not triangle_free:\n        break\nprint(f\"Triangle-free: {triangle_free}\")\n\n# Verify maximal\nmaximal = True\nfor u in range(14):\n    for v in range(u+1, 14):\n        if (u,v) not in edges and (v,u) not in edges:\n            # Check if adding this edge creates a triangle\n            creates_triangle = False\n            for w in range(14):\n                if w != u and w != v:\n                    if ((u,w) in edges or (w,u) in edges) and ((v,w) in edges or (w,v) in edges):\n                        creates_triangle = True\n                        break\n            if not creates_triangle:\n                maximal = False\n                print(f\"Can add edge ({u},{v}) without creating triangle\")\n                break\n    if not maximal:\n        break\nprint(f\"Maximal: {maximal}\")"
