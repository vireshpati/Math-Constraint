      "args": {
        "code": "# Verify K_{8,8} is triangle-free and maximal\nn = 16\nedges = [(i, j) for i in range(8) for j in range(8, 16)]\nprint(f\"Number of edges: {len(edges)}\")\n\n# Check triangle-free\ntriangle_free = True\nfor u in range(n):\n    neighbors_u = set()\n    for (a,b) in edges:\n        if a == u: neighbors_u.add(b)\n        if b == u: neighbors_u.add(a)\n    for v in neighbors_u:\n        for w in neighbors_u:\n            if v < w:\n                if (v,w) in edges or (w,v) in edges:\n                    triangle_free = False\n                    print(f\"Triangle: {u}-{v}-{w}\")\n                    break\n        if not triangle_free:\n            break\n    if not triangle_free:\n        break\nprint(f\"Triangle-free: {triangle_free}\")\n\n# Check maximality\nmaximal = True\nnon_edges = []\nfor i in range(n):\n    for j in range(i+1, n):\n        if (i,j) not in edges and (j,i) not in edges:\n            non_edges.append((i,j))\n\nfor (i,j) in non_edges:\n    # Check if adding (i,j) creates a triangle\n    neighbors_i = set()\n    for (a,b) in edges:\n        if a == i: neighbors_i.add(b)\n        if b == i: neighbors_i.add(a)\n    neighbors_j = set()\n    for (a,b) in edges:\n        if a == j: neighbors_j.add(b)\n        if b == j: neighbors_j.add(a)\n    common = neighbors_i & neighbors_j\n    if len(common) == 0:\n        maximal = False\n        print(f\"Can add edge ({i},{j}) without creating triangle\")\n        break\nprint(f\"Maximal: {maximal}\")"
